# Copy to /etc/ua-linqinspect/ua-linqinspect.env and replace every CHANGE_ME.
UA_ENDPOINT_PORT=4840
UA_BIND_ADDRESS=127.0.0.1
UA_ADMIN_USER=admin
UA_ADMIN_PASS=CHANGE_ME
UA_SERVER_CERT=/opt/ua-linqinspect/certs/server/server_cert.der
UA_SERVER_PRIVATE_KEY=/opt/ua-linqinspect/certs/server/server_key.pem
UA_TRUSTED_CLIENT_CERTS_DIR=/opt/ua-linqinspect/certs/trusted_clients
UA_AUDIT_LOG=/var/lib/ua-linqinspect/server_audit.log

QC_AUTO_INSPECT=1
QC_INSPECT_INTERVAL=2.0
QC_NG_PROBABILITY=0.3
QC_NG_WINDOW=20
QC_OUTBOX_MAX_PENDING=1000
QC_OUTBOX_HIGH_WATERMARK=800
QC_OUTBOX_EXPORT_LIMIT=500

QC_DB_PATH=/opt/ua-linqinspect/data/qc-queue.sqlite
QC_STATE_BACKEND=sqlite
QC_STATE_DB_PATH=/opt/ua-linqinspect/data/qc-queue.sqlite
QC_STATE_PATH=/opt/ua-linqinspect/data/qc-state.json
QC_BACKUP_DIR=/opt/ua-linqinspect/data/backups
QC_BACKUP_KEEP=7
QC_BACKUP_METRICS_FILE=/var/lib/ua-linqinspect/qc-backup.prom

QC_STATION_ID=QCStation
QC_DELIVERY_AUTHORITY=node-red
QC_SENDER_LOCK_DIR=/opt/ua-linqinspect/data/.sender-authority
EDGE_DB_PATH=/opt/ua-linqinspect/data/edge-core.sqlite
EDGE_EVIDENCE_IMAGE_DIR=/opt/ua-linqinspect/data/evidence-images
EDGE_EVIDENCE_IMAGE_MAX_BYTES=8388608
EDGE_API_HOST=127.0.0.1
EDGE_API_PORT=8770
EDGE_API_BASE_URL=http://127.0.0.1:8770
EDGE_API_TOKEN=CHANGE_ME
EDGE_MES_TIMEOUT_SECONDS=3
EDGE_MAX_ATTEMPTS=4
# Optional MES auth. Configure at most one mode: bearer or HTTP Basic.
MES_BEARER_TOKEN=
EDGE_MES_BASIC_USER=
EDGE_MES_BASIC_PASS=
EDGE_LEASE_SECONDS=30

OPERATOR_CONSOLE_HOST=127.0.0.1
OPERATOR_CONSOLE_PORT=8780
OPERATOR_CONSOLE_USER=operator
OPERATOR_CONSOLE_PASSWORD=CHANGE_ME
OPERATOR_EDGE_TIMEOUT_SECONDS=5
UA_OPERATOR_TIMEOUT_SECONDS=5

UA_CLIENT_CERT=/opt/ua-linqinspect/certs/client/client_cert.der
UA_CLIENT_KEY=/opt/ua-linqinspect/certs/client/client_key.pem
UA_SERVER_CERT=/opt/ua-linqinspect/certs/server/server_cert.der
UA_CLIENT_APPLICATION_URI=urn:freeopcua:python:client

NODE_RED_PORT=1880
NODERED_BASE=http://127.0.0.1:1880

# Secure Node-RED baseline. Keep UA_ADMIN_USER/PASS and
# NODERED_OPCUA_USER/PASSWORD identical so the edge can authenticate to UA.
NODERED_ADMIN_USER=admin
NODERED_ADMIN_PASSWORD=CHANGE_ME
NODERED_CREDENTIAL_SECRET=CHANGE_ME
NODERED_HTTP_USER=prometheus
NODERED_HTTP_PASS=CHANGE_ME
NODERED_OPCUA_USER=admin
NODERED_OPCUA_PASSWORD=CHANGE_ME
NODERED_UI_HOST=127.0.0.1
QC_REPO_ROOT=/opt/ua-linqinspect
