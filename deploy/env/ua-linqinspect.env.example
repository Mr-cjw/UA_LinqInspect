# Copy to /etc/ua-linqinspect/ua-linqinspect.env and replace every CHANGE_ME.
UA_ENDPOINT_PORT=4840
UA_BIND_ADDRESS=127.0.0.1
UA_ADMIN_USER=admin
UA_ADMIN_PASS=CHANGE_ME
UA_SERVER_CERT=/opt/ua-linqinspect/certs/server/server_cert.der
UA_SERVER_PRIVATE_KEY=/opt/ua-linqinspect/certs/server/server_key.pem
UA_TRUSTED_CLIENT_CERTS_DIR=/opt/ua-linqinspect/certs/trusted_clients
UA_AUDIT_LOG=/var/lib/ua-linqinspect/server_audit.log

QC_AUTO_INSPECT=1
QC_INSPECT_INTERVAL=2.0
QC_NG_PROBABILITY=0.3
QC_NG_WINDOW=20

QC_DB_PATH=/opt/ua-linqinspect/data/qc-queue.sqlite
QC_BACKUP_DIR=/opt/ua-linqinspect/data/backups
QC_BACKUP_KEEP=7
QC_BACKUP_METRICS_FILE=/var/lib/ua-linqinspect/qc-backup.prom

NODE_RED_PORT=1880
NODERED_BASE=http://127.0.0.1:1880
