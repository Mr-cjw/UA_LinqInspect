[Unit]
Description=UA LinqInspect Edge Core Delivery Service
Documentation=file://@REPO_ROOT@/README.md
Wants=network-online.target
After=network-online.target
ConditionEnvironment=QC_DELIVERY_AUTHORITY=edge-core

[Service]
Type=simple
User=@RUN_USER@
Group=@RUN_GROUP@
WorkingDirectory=@REPO_ROOT@
EnvironmentFile=-@ENV_FILE@
Environment=PYTHONUNBUFFERED=1
Environment=HOME=/var/lib/ua-linqinspect
ExecStart=@REPO_ROOT@/.venv/bin/python -m edge_core.main
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
StateDirectory=ua-linqinspect
StateDirectoryMode=0750
ReadWritePaths=@REPO_ROOT@/data
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
