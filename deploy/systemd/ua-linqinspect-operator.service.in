[Unit]
Description=UA LinqInspect Local Operator Console
Documentation=file://@REPO_ROOT@/operator_console/static/index.html
Wants=network-online.target ua-linqinspect-server.service ua-linqinspect-edge-core.service
After=network-online.target ua-linqinspect-server.service ua-linqinspect-edge-core.service

[Service]
Type=simple
User=@RUN_USER@
Group=@RUN_GROUP@
WorkingDirectory=@REPO_ROOT@
EnvironmentFile=-@ENV_FILE@
Environment=PYTHONUNBUFFERED=1
Environment=HOME=/var/lib/ua-linqinspect
ExecStart=@REPO_ROOT@/.venv/bin/python -m operator_console.main
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
StateDirectory=ua-linqinspect
StateDirectoryMode=0750
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
