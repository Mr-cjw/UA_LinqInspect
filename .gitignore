# Python
__pycache__/
*.py[cod]
.venv/

# 本地 conda 环境（可重建，不入库）
.conda/
.conda-pkgs/

# Node-RED 本地运行时与缓存
.node-red/*
!.node-red/package.json
!.node-red/package-lock.json
.npm-cache/
.appdata/
.localappdata/

# Node dependency management
/node_modules/
# Patch sources and manifests are tracked
!/package.json
!/package-lock.json
!/patches/

# 构建/下载/临时目录
.tmp/
.build/
.wheels/

# 本地 Git 元数据（本环境 .git 只读时的备用目录）
.git/
.gitstore/

# 运行时产物
*.log
data/

# 系统文件
.DS_Store
Thumbs.db

# Local OPC UA certificates and private keys
certs/
.node-red/flows_cred.json
.node-red/flows.json
